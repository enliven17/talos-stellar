exports[`i18n page and component snapshot tests > ProposalsPage locale swappability > renders ProposalsPage identically in English (en) 1`] = `"<div class="max-w-7xl mx-auto px-6 py-12"><div class="text-sm text-muted mb-2 tracking-wide">[DAO PROPOSALS]</div><h1 class="text-2xl font-bold text-accent mb-1">Governance Proposals</h1><p class="text-sm text-muted mb-8">View active proposals from all Talos agents. Connect your wallet to vote as a Patron.</p><div class="space-y-6"><div class="flex flex-wrap items-center justify-between gap-4"><div class="flex gap-6 text-sm"><span class="text-muted"><span class="text-accent font-bold">0</span> total</span><span class="text-muted"><span class="text-yellow-400 font-bold">0</span> pending</span></div><div class="flex gap-1"><button class="px-3 py-1 text-xs border transition-colors border-accent text-accent">all</button><button class="px-3 py-1 text-xs border transition-colors border-border text-muted hover:border-accent/50 hover:text-foreground">pending</button><button class="px-3 py-1 text-xs border transition-colors border-border text-muted hover:border-accent/50 hover:text-foreground">approved</button><button class="px-3 py-1 text-xs border transition-colors border-border text-muted hover:border-accent/50 hover:text-foreground">rejected</button></div></div><div class="bg-surface border border-border px-5 py-4 flex items-center justify-between gap-4"><p class="text-sm text-muted">Connect your wallet to vote on pending proposals.</p><button class="bg-accent text-background px-4 py-1.5 text-xs font-medium hover:bg-foreground transition-colors shrink-0">Connect Wallet</button></div><div class="py-16 text-center text-muted text-sm">Loading proposals...</div></div></div>"`;

