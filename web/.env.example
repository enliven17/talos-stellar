# ─── Database (Supabase) ──────────────────────────────────
# Get from: Supabase Dashboard → Project Settings → Database
# Use "Transaction" pooler URL for DATABASE_URL (port 6543)
# Use "Direct" connection URL for DIRECT_URL (port 5432)
DATABASE_URL=postgresql://postgres.XXXX:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://postgres.XXXX:PASSWORD@db.XXXX.supabase.co:5432/postgres

# ─── Public URL / forwarded host validation ───────────────
# Canonical public base URL used for redirects, callbacks, and generated API
# links, and as the origin of the URLs in /sitemap.xml and the Sitemap line of
# /robots.txt. Also treated as a trusted host when validating Host headers.
# In production, leave it unset and the sitemap is empty rather than listing
# localhost URLs.
APP_URL=https://talos-stellar.vercel.app
NEXT_PUBLIC_APP_URL=https://talos-stellar.vercel.app

# Comma-separated list of additional hostnames allowed in Host /
# X-Forwarded-Host headers (e.g. "talos.example.com,www.talos.example.com").
# Untrusted or ambiguous values are rejected and never influence generated
# URLs. In non-production, localhost/127.0.0.1/[::1]/*.local are trusted
# automatically and default to http when no X-Forwarded-Proto is present.
TRUSTED_HOSTS=talos-stellar.vercel.app,localhost:3000

# ─── Stellar Network ──────────────────────────────────────
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# NEXT_PUBLIC_ variants required for client-side code (soroban.ts / launch page)
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# USDC issuer. Optional: defaults to Circle's issuer for the network above.
# Validated against the network at startup (see README "Stellar asset config validation").
# STELLAR_USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
# NEXT_PUBLIC_STELLAR_USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
# Mainnet only: set to true to allow a non-Circle USDC issuer.
# STELLAR_ALLOW_CUSTOM_USDC_ISSUER=false
# NEXT_PUBLIC_STELLAR_ALLOW_CUSTOM_USDC_ISSUER=false

# ─── Stellar Operator (Server-side signing) ──────────────
# Generates: stellar keys generate operator --network testnet
# View secret: stellar keys show operator
STELLAR_OPERATOR_SECRET_KEY=SXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Operator treasury public key (used for server-side authorization checks)
STELLAR_OPERATOR_PUBLIC_KEY=GCEFRNTKTNYOS7QFQ7USU57N3NZZA65FXAVGA2WKFYJGKQZSM5WNAKRL

# Operator treasury public key (client-side variant exposed to the browser frontend)
NEXT_PUBLIC_STELLAR_OPERATOR_PUBLIC_KEY=GCEFRNTKTNYOS7QFQ7USU57N3NZZA65FXAVGA2WKFYJGKQZSM5WNAKRL

# ─── Soroban Smart Contracts ─────────────────────────────
# Run: cd contracts && ./deploy.sh testnet (returns contract IDs)
NEXT_PUBLIC_TALOS_REGISTRY_CONTRACT=CXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
NEXT_PUBLIC_TALOS_NAME_SERVICE_CONTRACT=CXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
NEXT_PUBLIC_TALOS_DIVIDENDS_CONTRACT=CXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ─── Wallet Connection (Stellar) ─────────────────────────
NEXT_PUBLIC_STELLAR_WALLET_NETWORK=testnet

# ─── x402 on Stellar ─────────────────────────────────────
X402_FACILITATOR_URL=https://channels.openzeppelin.com/x402/testnet
X402_API_KEY=
X402_SETTLEMENT_NETWORK=stellar-testnet

# ─── Simulated Cross-Chain Webhook Auth ──────────────────
# Shared HMAC secret used by POST /api/commerce/cross-chain-webhook.
# The caller must sign the raw JSON body with HMAC-SHA256 and send it as X-Signature.
CROSS_CHAIN_WEBHOOK_SECRET=replace-with-a-long-random-secret

# ─── AI Services ──────────────────────────────────────────
OPENAI_API_KEY=sk-proj-...
GROQ_API_KEY=gsk_...
# Optional override for fulfillment LLM model (defaults to llama-3.3-70b-versatile for Groq, gpt-4o for OpenAI)
FULFILLMENT_LLM_MODEL=
TAVILY_API_KEY=tvly-...

# ─── Talos Genesis ────────────────────────────────────────
NEXT_PUBLIC_TALOS_CREATION_XLM=20

# ─── Webhook Delivery ─────────────────────────────────────
# Enable to allow outbound webhook delivery for protocol events.
# WEBHOOK_DELIVERY_ENABLED=false

# 64-char hex string (32 bytes) used to encrypt webhook secrets at rest.
# Generate with: openssl rand -hex 32
# WEBHOOK_SECRET_ENCRYPTION_KEY=

# Default dual-sign overlap when rotating webhook secrets (seconds).
WEBHOOK_SECRET_ROTATION_GRACE_SECONDS=86400

# Optional: customise delivery parameters.
# WEBHOOK_DEFAULT_MAX_ATTEMPTS=5
# WEBHOOK_BACKOFF_BASE_MS=1000
# WEBHOOK_BACKOFF_MAX_MS=60000
# WEBHOOK_DELIVERY_TIMEOUT_MS=10000
# WEBHOOK_MAX_PAYLOAD_BYTES=64000
# WEBHOOK_LEASE_TTL_SECONDS=300
# WEBHOOK_HEARTBEAT_EXTEND_SECONDS=300

# ─── Observability ────────────────────────────────────────
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
LOG_LEVEL=info

# ─── Distributed Rate Limiting ───────────────────────────
# Redis URL for shared atomic rate-limit counters across horizontally
# scaled instances. When unset, falls back to per-process in-memory
# store (safe for single-instance dev; not shared across pods).
#
# Supported formats: redis://[:password@]host[:port][/db]
REDIS_URL=

# Trusted upstream proxy hops for X-Forwarded-For parsing (Vercel/Railway = 1).
TRUSTED_PROXY_DEPTH=1

# Deny requests when Redis is unreachable (fail-closed). Default: fail-open.
RATE_LIMIT_FAIL_CLOSED=false

# Per-bucket quota overrides (optional — defaults shown).
RATE_LIMIT_AUTH_LIMIT=20
RATE_LIMIT_AUTH_WINDOW_MS=60000
RATE_LIMIT_READ_LIMIT=100
RATE_LIMIT_READ_WINDOW_MS=60000
RATE_LIMIT_WRITE_KEY_LIMIT=30
RATE_LIMIT_WRITE_IP_LIMIT=30
RATE_LIMIT_WRITE_WINDOW_MS=60000
RATE_LIMIT_CSP_REPORT_LIMIT=120
RATE_LIMIT_CSP_REPORT_WINDOW_MS=60000

# ─── Content-Security-Policy ──────────────────────────────
# The proxy (src/proxy.ts) sends a per-request nonce CSP on every page.
# CSP_ENFORCE=false (default) sends Content-Security-Policy-Report-Only;
# set it to true/1/yes/on to enforce. Violations are POSTed to
# /api/csp-report in both modes.
CSP_ENFORCE=false
# Optional comma-separated sources merged into the per-environment
# allow-lists (e.g. a staging RPC): CSP_EXTRA_CONNECT_SRC, CSP_EXTRA_IMG_SRC,
# CSP_EXTRA_FRAME_SRC. Malformed tokens are dropped, never interpolated.
CSP_EXTRA_CONNECT_SRC=
CSP_EXTRA_IMG_SRC=
CSP_EXTRA_FRAME_SRC=

# ─── Health probe timeouts (optional) ─────────────────────
# Bounded dependency timeouts for /api/health readiness probes.
# Invalid / out-of-range values fall back to the defaults.
# HEALTH_DB_TIMEOUT_MS=2000
# HEALTH_STELLAR_TIMEOUT_MS=3000

# ─── Background Jobs ──────────────────────────────────────
# Master switch — defaults to disabled for opt-in rollout.
# Existing code paths keep synchronous/fire-and-forget behaviour until
# an operator explicitly sets JOBS_ENABLED=true.
# JOBS_ENABLED=false
# Stable identifier for this worker process in leases / logs. Auto-generated when unset.
# JOBS_WORKER_ID=

# Shared secret for the /api/internal/jobs/drain endpoint (cron/Railway trigger).
# INTERNAL_JOBS_SECRET=

# Bearer token for /api/admin/jobs/* inspection endpoints.
# ADMIN_API_KEY=

# ─── Outbox (transactional event dispatch) ────────────────
# Master switch — opt-in, backward-compatible rollout.
# OUTBOX_ENABLED=false
# Stable identifier for this worker process in leases / logs. Auto-generated when unset.
# OUTBOX_WORKER_ID=

# Shared secret for the /api/internal/outbox/drain endpoint (cron/Railway trigger).
# OUTBOX_DISPATCH_SECRET=

# ─── Reconciler ───────────────────────────────────────────
# Background loop that reconciles on-chain Stellar state with the local DB.
# RECONCILER_ENABLED=false

# ─── Ops / Backup ─────────────────────────────────────────
# Shared secret for operator-only endpoints (Authorization: Bearer or X-Ops-Token).
# Required for the backup/restore API (/api/ops/backup, /api/ops/restore).
# Generate with: openssl rand -hex 32
# OPS_ADMIN_SECRET=

# Disable the backup module entirely (set to 1 to opt out of the gated rollout).
# TALOS_BACKUP_DISABLED=0

# Directory where backup artefacts are written (default: .backups).
# TALOS_BACKUP_DIR=.backups

# Maximum size in bytes for a single backup artefact (default: 5 MiB = 5242880).
# TALOS_BACKUP_MAX_BYTES=5242880

# How many days backup artefacts are retained before pruning (default: 14, max: 365).
# TALOS_BACKUP_RETENTION_DAYS=14

# Timeout in ms for a single backup operation (default: 30000, range: 1000–300000).
# TALOS_BACKUP_TIMEOUT_MS=30000

# ─── Idempotency Key Cleanup ──────────────────────────────
# Completed commerce-job idempotency keys are reclaimed by the bounded
# cleanup endpoint POST /api/internal/idempotency/cleanup (see
# src/lib/idempotency). In-flight keys are never expired.
# Shared secret required by that endpoint (x-internal-idempotency-secret).
# INTERNAL_IDEMPOTENCY_SECRET=
# How long a completed key is retained before it becomes eligible (default 30 days).
# IDEMPOTENCY_KEY_RETENTION_MS=2592000000
# Max rows deleted per cleanup run; hard-capped at 5000 (default 500).
# IDEMPOTENCY_CLEANUP_BATCH_SIZE=500
