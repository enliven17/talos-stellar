{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "buyerPublicKey": {
      "type": "string",
      "minLength": 1
    },
    "amount": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 999999999999
    }
  },
  "required": [
    "buyerPublicKey",
    "amount"
  ]
}
