{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "post",
        "research",
        "reply",
        "engagement",
        "commerce",
        "approval"
      ]
    },
    "content": {
      "type": "string",
      "minLength": 1,
      "maxLength": 5000
    },
    "channel": {
      "type": "string",
      "maxLength": 100
    },
    "status": {
      "default": "completed",
      "type": "string",
      "maxLength": 50
    }
  },
  "required": [
    "type",
    "content"
  ]
}
