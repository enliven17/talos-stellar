{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "transaction",
        "strategy",
        "policy",
        "channel"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "amount": {
      "type": "number",
      "minimum": 0
    }
  },
  "required": [
    "type",
    "title"
  ]
}
