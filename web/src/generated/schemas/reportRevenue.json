{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "amount": {
      "type": "string",
      "minLength": 1
    },
    "currency": {
      "default": "USDC",
      "type": "string"
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "txHash": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "amount",
    "source"
  ]
}
