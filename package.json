    "lockfile:check:json": "node scripts/check-lockfile-drift.mjs --json",
    "test:lockfile-drift": "node --test scripts/check-lockfile-drift.test.mjs",
    "licenses:report": "node scripts/generate-license-report.mjs",
    "licenses:test": "node --test scripts/generate-license-report.test.mjs",
    "sbom:verify": "node scripts/verify-sbom.mjs",
    "test:sbom-verify": "node --test scripts/verify-sbom.test.mjs",
    "test:contracts-readme": "node --test scripts/verify-contracts-readme.test.mjs",
    "env:template:check": "node scripts/check-env-template.mjs",
    "test:env-template": "node --test scripts/check-env-template.test.mjs"
