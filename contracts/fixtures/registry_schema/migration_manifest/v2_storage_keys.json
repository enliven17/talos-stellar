{
  "schema_version": 2,
  "contract": "TalosRegistry",
  "description": "Synthetic v2 (SCHEMA_TIMELOCK_DEFAULTS) storage key set. Same keys as v1 except TimelockConfig is now explicitly persisted with the backfilled default (min_delay=0, grace_period=604800); every other key is byte-identical to v1.",
  "keys": [
    {"key": "NextTalosId",        "present": true,  "value_kind": "u32"},
    {"key": "Talos",              "present": true,  "value_kind": "Talos(u32) struct"},
    {"key": "CreatorOf",           "present": true,  "value_kind": "CreatorOf(u32) addr"},
    {"key": "ProtocolWallet",      "present": true,  "value_kind": "Address"},
    {"key": "ProtocolFeeBps",      "present": true,  "value_kind": "u32"},
    {"key": "PendingAdmin",        "present": false, "value_kind": "Address"},
    {"key": "TimelockConfig",      "present": true,  "value_kind": "explicit_persisted", "backfill": {"min_delay": 0, "grace_period": 604800}},
    {"key": "TimelockProposal",    "present": false, "value_kind": "TimelockProposal(u64) struct"},
    {"key": "NextTimelockId",      "present": false, "value_kind": "u64"},
    {"key": "LastTouched",         "present": false, "value_kind": "u32"},
    {"key": "Guardians",           "present": false, "value_kind": "Vec<Address>"},
    {"key": "PauseState",          "present": false, "value_kind": "PauseState struct"},
    {"key": "PauseController",     "present": false, "value_kind": "Address"},
    {"key": "ResumeController",    "present": false, "value_kind": "Address"}
  ]
}
